# Uncomment the next line to define a global platform for your project

target 'PurchasesHybridCommon' do
  platform :ios, '13.0'
  use_frameworks!

  pod 'RevenueCat', '5.93.0'

  target 'PurchasesHybridCommonTests' do
    # Pods for testing
    pod 'Quick', '5.0.1'
    pod 'Nimble', '10.0.0'
    # Required to @testable import PurchasesHybridCommonUI (which links RevenueCatUI).
    pod 'RevenueCatUI', '5.93.0'
  end

  target 'PurchasesHybridCommonIntegrationTests' do
    # Pods for testing
    pod 'Quick', '5.0.1'
    pod 'Nimble', '10.0.0'
  end

end

target 'PurchasesHybridCommonUI' do
  platform :ios, '13.0'
  use_frameworks!

  pod 'RevenueCat', '5.93.0'
  pod 'RevenueCatUI', '5.93.0'
end

target 'ObjCAPITester' do
  platform :ios, '13.0'
  use_frameworks!

  pod 'RevenueCat', '5.93.0'
  pod 'RevenueCatUI', '5.93.0'
end

# Xcode 27 enforces a minimum deployment target of iOS 15. CocoaPods takes each pod target's
# deployment target from the podspec, not from the `platform` declared above, so pods that
# declare less than iOS 15 need to be raised here. Resource bundle targets need this too.
# Scoped to the Xcode 27 SDKs so older Xcode versions keep building the pods unchanged.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET[sdk=iphoneos27*]'] = '15.0'
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET[sdk=iphonesimulator27*]'] = '15.0'
    end
  end
end

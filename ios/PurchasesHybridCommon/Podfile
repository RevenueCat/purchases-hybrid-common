# Uncomment the next line to define a global platform for your project

target 'PurchasesHybridCommon' do
  platform :ios, '13.0'
  use_frameworks!

  pod 'RevenueCat', '5.87.1'

  target 'PurchasesHybridCommonTests' do
    # Pods for testing
    pod 'Quick', '5.0.1'
    pod 'Nimble', '10.0.0'
    # Required to @testable import PurchasesHybridCommonUI (which links RevenueCatUI).
    pod 'RevenueCatUI', '5.87.1'
  end

  target 'PurchasesHybridCommonIntegrationTests' do
    # Pods for testing
    pod 'Quick', '5.0.1'
    pod 'Nimble', '10.0.0'
  end

end

target 'PurchasesHybridCommonUI' do
  platform :ios, '13.0'
  use_frameworks!

  pod 'RevenueCat', '5.87.1'
  pod 'RevenueCatUI', '5.87.1'
end

target 'ObjCAPITester' do
  platform :ios, '13.0'
  use_frameworks!

  pod 'RevenueCat', '5.87.1'
  pod 'RevenueCatUI', '5.87.1'
end

# Xcode 27 enforces a minimum deployment target of iOS 15, and CocoaPods derives each pod
# target's deployment target from the `platform` declared above. Scoped to the Xcode 27 SDKs
# so that older Xcode versions keep building the pods against the platforms declared above.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET[sdk=iphoneos27*]'] = '15.0'
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET[sdk=iphonesimulator27*]'] = '15.0'
    end
  end
end
